# Feature Flags
# Controlan qué funcionalidades están habilitadas/deshabilitadas
VITE_FEATURE_BULK_UPLOAD_ENABLED=true
VITE_AWS_UPLOAD_ENABLED=false

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
VITE_MAX_FILE_SIZE_MB=5

# AWS S3 Configuration
# Solo necesario si VITE_AWS_UPLOAD_ENABLED=true
VITE_AWS_REGION=us-east-1
VITE_AWS_ACCESS_KEY_ID=your_access_key_here
VITE_AWS_SECRET_ACCESS_KEY=your_secret_key_here

# S3 Bucket Configuration
VITE_S3_BUCKET_NAME=your-bucket-name
VITE_S3_BUCKET_REGION=us-east-1
