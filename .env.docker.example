# Docker Environment Variables Example
#
# IMPORTANT: Vite environment variables are embedded during BUILD time, not runtime.
# To customize these values:
# 1. Edit docker-compose.yml in the "build.args" section
# 2. Rebuild the image: docker-compose build --no-cache
#
# Default values are set in Dockerfile and docker-compose.yml

# Feature Flags (configured in docker-compose.yml)
VITE_FEATURE_BULK_UPLOAD_ENABLED=true
VITE_AWS_UPLOAD_ENABLED=false

# API Configuration (configured in docker-compose.yml)
VITE_API_BASE_URL=http://localhost:3001/api
VITE_MAX_FILE_SIZE_MB=5

# AWS S3 Configuration (only needed if VITE_AWS_UPLOAD_ENABLED=true)
# Add these as build args in docker-compose.yml if needed:
# VITE_AWS_REGION=us-east-1
# VITE_AWS_ACCESS_KEY_ID=your_access_key_here
# VITE_AWS_SECRET_ACCESS_KEY=your_secret_key_here
# VITE_S3_BUCKET_NAME=your-bucket-name
# VITE_S3_BUCKET_REGION=us-east-1
