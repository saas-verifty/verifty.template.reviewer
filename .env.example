# Feature Flags
# Controlan qué funcionalidades están habilitadas/deshabilitadas
VITE_FEATURE_BULK_UPLOAD_ENABLED=true
VITE_AWS_UPLOAD_ENABLED=true

# API Configuration
# Base URL del backend que provee el endpoint de presigned URL
VITE_API_BASE_URL=http://localhost:3001/api
VITE_MAX_FILE_SIZE_MB=5

# Data Source para el endpoint de presigned URL (test, v1, etc.)
VITE_DATA_SOURCE=test

# WeWeb Redirect Configuration
# URL de WeWeb a donde redirigir después de subir el archivo
VITE_WEWEB_REDIRECT_URL=https://your-weweb-app.com/success
